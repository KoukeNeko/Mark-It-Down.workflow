#!/bin/bash
# mark-it-down — install / remove the Finder Quick Actions（Homebrew 安裝後的入口指令）
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=src/lib.sh
source "$here/src/lib.sh"
usage() { t cli_usage; }

case "${1:-help}" in
  install)   shift; exec "$here/install.sh" "$@" ;;
  uninstall) shift; exec "$here/uninstall.sh" "$@" ;;
  version|-v|--version) tr -d '[:space:]' <"$here/VERSION"; echo ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
